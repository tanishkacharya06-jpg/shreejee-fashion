# Generate a long random secret for any public deployment.
SHREEJEE_SECRET_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=5000

# Optional online payments. Do not commit real keys into source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- v1.0.12 (all optional - copy this file to ".env" and fill in what you use) ----
# WhatsApp alerts to the owner (WhatsApp Cloud API from Meta):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# If Meta asks for an approved message template, put its name here (it needs ONE text variable in the body):
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Free alternative: CallMeBot (message the CallMeBot WhatsApp bot once to get a key)
CALLMEBOT_APIKEY=
# Owner number for alerts (defaults to 8340453008)
OWNER_WHATSAPP=
# "Login with Google": OAuth Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
# Phone OTP by SMS (Fast2SMS API key). For testing without SMS set SF_OTP_DEV=1 (code prints in the console).
FAST2SMS_API_KEY=
SF_OTP_DEV=0
# Daily automatic database backup (1 = on)
SF_AUTO_BACKUP=1

# ---- Android app: lets the app find the newest Cloudflare address (see android-app/README.txt) ----
SF_GITHUB_TOKEN=
SF_GIST_ID=
