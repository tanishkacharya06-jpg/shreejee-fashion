<resources>
    <style name="Theme.Shreejee" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/sf_cream</item>
        <item name="android:statusBarColor">@color/sf_green</item>
        <item name="android:navigationBarColor">@color/sf_cream</item>
        <item name="alertDialogTheme">@style/Theme.Shreejee.Dialog</item>
    </style>
    <style name="Theme.Shreejee.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/sf_green</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>
</resources>
